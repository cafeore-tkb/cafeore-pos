# docker compose を使う場合は同じ内容の .env で起動できる
DATABASE_URL=postgresql://postgres:example@localhost:5432
PORT=8080
# 1 インスタンスが張る DB 接続の上限（LISTEN の 1 本は別）。空なら 5。
DB_MAX_OPEN_CONNS=

# 在庫の通知先（Slack Incoming Webhook）。空なら通知せずログに出すだけ。
SLACK_WEBHOOK_URL=
# 商品の登録・変更・削除や棚卸し・入荷、オーダーストップの通知先。空なら SLACK_WEBHOOK_URL に流す。
SLACK_ACTIVITY_WEBHOOK_URL=
# POST /api/inventory/remind を叩ける相手。どちらも空ならリマインドは無効（503）。
#   - INVENTORY_CRON_SECRET: X-Cron-Secret ヘッダーと照合する合言葉（ローカル・手動実行用）
#   - INVENTORY_REMIND_INVOKER / INVENTORY_REMIND_AUDIENCE: 本番の Cloud Scheduler が付ける
#     Google ID トークンの発行元 SA と audience（infra の gcp/inventory_remind.tf）
INVENTORY_CRON_SECRET=
INVENTORY_REMIND_INVOKER=
INVENTORY_REMIND_AUDIENCE=
# リマインドに載せる POS の URL（例: https://pos.example.com）。空ならリンクを付けない。
POS_BASE_URL=

# Square Terminal 連携。SQUARE_ACCESS_TOKEN が無ければ無効（レジに Square のボタンが出ない）。
# 端末は POS の管理画面（/square-devices）で登録する。手順は README の「Square Terminal 連携」。
#   - SQUARE_ENVIRONMENT: sandbox か production（空なら sandbox）
#   - SQUARE_LOCATION_ID: 端末をペアリングする店舗。空ならアカウントの既定の店舗
#   - SQUARE_WEBHOOK_URL: Developer Console に登録した通知 URL をそのまま（署名の検証に使う）
SQUARE_ACCESS_TOKEN=
SQUARE_ENVIRONMENT=sandbox
SQUARE_LOCATION_ID=
SQUARE_WEBHOOK_SIGNATURE_KEY=
SQUARE_WEBHOOK_URL=

# API を叩ける相手を Cloudflare Access か GCP の IAP で絞るか。空か off なら絞らない（ローカルはこれ）。
# 手順は README の「API の認証」。
#   - off / cloudflare-access / iap / cloudflare-access+iap（どちらも受け付ける）。
#     off 以外は後ろに -report-only を付けると、弾かずにログに出す（例: cloudflare-access+iap-report-only）
#   - CF_ACCESS_TEAM_DOMAIN: <チーム名>.cloudflareaccess.com（cloudflare-access を含むときだけ）
#   - CF_ACCESS_AUD: Access のアプリケーションの AUD タグ（cloudflare-access を含むときだけ）
#   - IAP_AUDIENCE: IAP の JWT の aud。/projects/<プロジェクト番号>/global/backendServices/<backend の数字の ID>
#     （iap を含むときだけ。カンマ区切りで複数可）
#   - AUTH_STAFF_EMAILS / AUTH_VIEWER_EMAILS: 何でもできる相手 / 読むだけの相手（カンマ区切り。どの方式でも共通）
AUTH_MODE=off
CF_ACCESS_TEAM_DOMAIN=
CF_ACCESS_AUD=
IAP_AUDIENCE=
AUTH_STAFF_EMAILS=
AUTH_VIEWER_EMAILS=
