# docker compose を使う場合は同じ内容の .env で起動できる
DATABASE_URL=postgresql://postgres:example@localhost:5432
PORT=8080

# gorm の AutoMigrate を走らせるかどうか。"true" のときだけ走る。
#
# compose で立てる Postgres は空なので、ローカルでは true が要る。
# 本番はスキーマが手で作られているので false（infra の gcp/cloud_run.tf）。
RUN_MIGRATIONS=true

# 在庫の通知先（Slack Incoming Webhook）。空なら通知せずログに出すだけ。
SLACK_WEBHOOK_URL=
# POST /api/inventory/remind を叩ける相手。どちらも空ならリマインドは無効（503）。
#   - INVENTORY_CRON_SECRET: X-Cron-Secret ヘッダーと照合する合言葉（ローカル・手動実行用）
#   - INVENTORY_REMIND_INVOKER / INVENTORY_REMIND_AUDIENCE: 本番の Cloud Scheduler が付ける
#     Google ID トークンの発行元 SA と audience（infra の gcp/inventory_remind.tf）
INVENTORY_CRON_SECRET=
INVENTORY_REMIND_INVOKER=
INVENTORY_REMIND_AUDIENCE=
# リマインドに載せる POS の URL（例: https://pos.example.com）。空ならリンクを付けない。
POS_BASE_URL=

# Square Terminal 連携。SQUARE_ACCESS_TOKEN と SQUARE_DEVICE_ID が無ければ無効
# （レジに Square のボタンが出ない）。手順は README の「Square Terminal 連携」。
#   - SQUARE_ENVIRONMENT: sandbox か production（空なら sandbox）
#   - SQUARE_DEVICE_ID: go run ./cmd/square-pair で得た値。Sandbox ではテスト用の device_id
#   - SQUARE_WEBHOOK_URL: Developer Console に登録した通知 URL をそのまま（署名の検証に使う）
SQUARE_ACCESS_TOKEN=
SQUARE_ENVIRONMENT=sandbox
SQUARE_DEVICE_ID=
SQUARE_WEBHOOK_SIGNATURE_KEY=
SQUARE_WEBHOOK_URL=
