{
  "StatusResponse": {
    "type": "object",
    "required": ["status", "timestamp", "version", "database"],
    "properties": {
      "status": {
        "type": "string",
        "example": "ok"
      },
      "timestamp": {
        "type": "string",
        "format": "date-time"
      },
      "version": {
        "type": "string",
        "example": "1.0.0"
      },
      "database": {
        "type": "string",
        "example": "connected"
      }
    }
  },
  "ItemResponse": {
    "type": "object",
    "required": ["id", "name", "abbr", "item_type"],
    "properties": {
      "id": {
        "type": "string",
        "format": "uuid"
      },
      "name": {
        "type": "string"
      },
      "abbr": {
        "type": "string"
      },
      "item_type": {
        "$ref": "#/components/schemas/ItemTypeResponse"
      }
    }
  },
  "ItemCreateRequest": {
    "type": "object",
    "required": ["name", "abbr", "item_type_id"],
    "properties": {
      "name": {
        "type": "string"
      },
      "abbr": {
        "type": "string"
      },
      "item_type_id": {
        "type": "string",
        "format": "uuid"
      }
    }
  },
  "ItemUpdateRequest": {
    "type": "object",
    "required": ["id", "name", "abbr", "item_type_id"],
    "properties": {
      "id": {
        "type": "string",
        "format": "uuid"
      },
      "name": {
        "type": "string"
      },
      "abbr": {
        "type": "string"
      },
      "item_type_id": {
        "type": "string",
        "format": "uuid"
      }
    }
  },
  "MenuItemResponse": {
    "type": "object",
    "required": ["item", "quantity"],
    "properties": {
      "item": {
        "$ref": "#/components/schemas/ItemResponse"
      },
      "quantity": {
        "type": "integer",
        "minimum": 1
      }
    }
  },
  "MenuItemRequest": {
    "type": "object",
    "required": ["item_id", "quantity"],
    "properties": {
      "item_id": {
        "type": "string",
        "format": "uuid"
      },
      "quantity": {
        "type": "integer",
        "minimum": 1
      }
    }
  },
  "MenuResponse": {
    "type": "object",
    "required": ["id", "name", "abbr", "price", "key", "items"],
    "properties": {
      "id": {
        "type": "string",
        "format": "uuid"
      },
      "name": {
        "type": "string"
      },
      "abbr": {
        "type": "string"
      },
      "price": {
        "type": "integer"
      },
      "key": {
        "type": "string"
      },
      "items": {
        "type": "array",
        "items": {
          "$ref": "#/components/schemas/MenuItemResponse"
        }
      }
    }
  },
  "MenuCreateRequest": {
    "type": "object",
    "required": ["name", "abbr", "price", "key", "items"],
    "properties": {
      "name": {
        "type": "string"
      },
      "abbr": {
        "type": "string"
      },
      "price": {
        "type": "integer",
        "minimum": 0
      },
      "key": {
        "type": "string"
      },
      "items": {
        "type": "array",
        "minItems": 1,
        "items": {
          "$ref": "#/components/schemas/MenuItemRequest"
        }
      }
    }
  },
  "MenuUpdateRequest": {
    "allOf": [
      {
        "$ref": "#/components/schemas/MenuCreateRequest"
      },
      {
        "type": "object",
        "required": ["id"],
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          }
        }
      }
    ]
  },
  "ItemTypeResponse": {
    "type": "object",
    "required": ["id", "name", "display_name"],
    "properties": {
      "id": {
        "type": "string",
        "format": "uuid"
      },
      "name": {
        "type": "string"
      },
      "display_name": {
        "type": "string"
      }
    }
  },
  "ItemTypeCreateRequest": {
    "type": "object",
    "required": ["name", "display_name"],
    "properties": {
      "name": {
        "type": "string"
      },
      "display_name": {
        "type": "string"
      }
    }
  },
  "ItemTypeUpdateRequest": {
    "type": "object",
    "required": ["id", "name", "display_name"],
    "properties": {
      "id": {
        "type": "string",
        "format": "uuid"
      },
      "name": {
        "type": "string"
      },
      "display_name": {
        "type": "string"
      }
    }
  },
  "MenuInfo": {
    "type": "object",
    "required": ["id", "menu_name", "unit_price", "menu", "assignee"],
    "properties": {
      "id": {
        "type": "string",
        "format": "uuid",
        "description": "注文明細ID"
      },
      "menu_name": {
        "type": "string",
        "description": "注文時点のメニュー名"
      },
      "unit_price": {
        "type": "integer",
        "description": "注文時点のメニュー価格"
      },
      "menu": {
        "$ref": "#/components/schemas/MenuResponse"
      },
      "assignee": {
        "type": "string",
        "nullable": true
      }
    }
  },
  "OrderCupResponse": {
    "type": "object",
    "required": [
      "id",
      "order_menu_id",
      "item",
      "ready_at",
      "served_at",
      "dripper",
      "dripper_position",
      "drip_id",
      "brew_started_at",
      "brew_finished_at"
    ],
    "properties": {
      "id": {
        "type": "string",
        "format": "uuid"
      },
      "order_menu_id": {
        "type": "string",
        "format": "uuid",
        "description": "このカップを含む注文明細のID（MenuInfo.id）"
      },
      "item": {
        "$ref": "#/components/schemas/ItemResponse"
      },
      "ready_at": {
        "type": "string",
        "format": "date-time",
        "nullable": true,
        "description": "このカップが準備完了になった時刻。未準備なら null"
      },
      "served_at": {
        "type": "string",
        "format": "date-time",
        "nullable": true,
        "description": "このカップを提供した時刻。未提供なら null"
      },
      "dripper": {
        "type": "integer",
        "nullable": true,
        "minimum": 1,
        "maximum": 6,
        "description": "CaOS が置いたドリッパーの番号（1〜6）。未割当なら null。以下の CaOS の列は CaOS 以外の画面は読まない"
      },
      "dripper_position": {
        "type": "integer",
        "nullable": true,
        "description": "CaOS のドリッパーの中の順番（小さいほど先）。サーバーが決める（途中に入れると後ろを +1 する。抜けた番号は詰めない）"
      },
      "drip_id": {
        "type": "string",
        "format": "uuid",
        "nullable": true,
        "description": "CaOS のカードの印。同じ値のカップを 1 枚のカード（1 回のドリップ）で淹れる"
      },
      "brew_started_at": {
        "type": "string",
        "format": "date-time",
        "nullable": true,
        "description": "CaOS で抽出を始めた時刻"
      },
      "brew_finished_at": {
        "type": "string",
        "format": "date-time",
        "nullable": true,
        "description": "CaOS で抽出を終えた時刻"
      }
    }
  },
  "MenuInfoCreate": {
    "type": "object",
    "required": ["menu_id", "assignee"],
    "properties": {
      "order_menu_id": {
        "type": "string",
        "format": "uuid",
        "description": "更新時に残す既存明細のID。新規明細では省略する。価格・名称はサーバーが保存する。"
      },
      "menu_id": {
        "type": "string",
        "format": "uuid"
      },
      "assignee": {
        "type": "string",
        "nullable": true
      }
    }
  },
  "OrderResponse": {
    "type": "object",
    "required": [
      "id",
      "order_id",
      "created_at",
      "billing_amount",
      "received",
      "menus",
      "cups"
    ],
    "properties": {
      "id": {
        "type": "string",
        "format": "uuid"
      },
      "order_id": {
        "type": "integer"
      },
      "created_at": {
        "type": "string",
        "format": "date-time"
      },
      "ready_at": {
        "type": "string",
        "format": "date-time",
        "nullable": true
      },
      "served_at": {
        "type": "string",
        "format": "date-time",
        "nullable": true
      },
      "billing_amount": {
        "type": "integer"
      },
      "received": {
        "type": "integer"
      },
      "discount_order_id": {
        "type": "integer",
        "nullable": true
      },
      "discount_order_cups": {
        "type": "integer"
      },
      "menus": {
        "type": "array",
        "items": {
          "$ref": "#/components/schemas/MenuInfo"
        }
      },
      "cups": {
        "type": "array",
        "description": "注文のカップ（1杯ずつ）。注文した順に並ぶ。グッズだけの注文では空",
        "items": {
          "$ref": "#/components/schemas/OrderCupResponse"
        }
      },
      "comments": {
        "type": "array",
        "items": {
          "$ref": "#/components/schemas/CommentResponse"
        }
      }
    }
  },
  "OrderCreateRequest": {
    "type": "object",
    "required": ["order_id", "billing_amount", "received", "menu_ids"],
    "properties": {
      "order_id": {
        "type": "integer",
        "example": 1
      },
      "billing_amount": {
        "type": "integer",
        "example": 500
      },
      "received": {
        "type": "integer",
        "example": 500,
        "default": 0
      },
      "discount_order_id": {
        "type": "integer",
        "nullable": true
      },
      "discount_order_cups": {
        "type": "integer",
        "default": 0
      },
      "menu_ids": {
        "type": "array",
        "items": {
          "$ref": "#/components/schemas/MenuInfoCreate"
        }
      },
      "comments": {
        "type": "array",
        "items": {
          "$ref": "#/components/schemas/CommentCreateRequest"
        }
      }
    }
  },
  "OrderUpdateRequest": {
    "type": "object",
    "required": ["id", "order_id", "billing_amount", "received", "menu_ids"],
    "properties": {
      "id": {
        "type": "string",
        "format": "uuid"
      },
      "order_id": {
        "type": "integer"
      },
      "ready_at": {
        "type": "string",
        "format": "date-time",
        "nullable": true
      },
      "served_at": {
        "type": "string",
        "format": "date-time",
        "nullable": true
      },
      "billing_amount": {
        "type": "integer"
      },
      "received": {
        "type": "integer"
      },
      "discount_order_id": {
        "type": "integer",
        "nullable": true
      },
      "discount_order_cups": {
        "type": "integer"
      },
      "menu_ids": {
        "type": "array",
        "items": {
          "$ref": "#/components/schemas/MenuInfoCreate"
        }
      }
    }
  },
  "OrderListItem": {
    "type": "object",
    "required": ["id", "order_id", "created_at", "billing_amount"],
    "properties": {
      "id": {
        "type": "string",
        "format": "uuid"
      },
      "order_id": {
        "type": "integer"
      },
      "created_at": {
        "type": "string",
        "format": "date-time"
      },
      "ready_at": {
        "type": "string",
        "format": "date-time",
        "nullable": true
      },
      "served_at": {
        "type": "string",
        "format": "date-time",
        "nullable": true
      },
      "billing_amount": {
        "type": "integer"
      },
      "received": {
        "type": "integer"
      },
      "discount_order_cups": {
        "type": "integer"
      }
    }
  },
  "CommentCreateRequest": {
    "type": "object",
    "required": ["author", "text"],
    "properties": {
      "author": {
        "type": "string"
      },
      "text": {
        "type": "string"
      }
    }
  },
  "CommentResponse": {
    "type": "object",
    "required": ["order_id", "author", "text", "created_at"],
    "properties": {
      "order_id": {
        "type": "string",
        "format": "uuid"
      },
      "author": {
        "type": "string"
      },
      "text": {
        "type": "string"
      },
      "created_at": {
        "type": "string",
        "format": "date-time"
      }
    }
  },
  "MasterStateResponse": {
    "type": "object",
    "required": ["created_at", "type"],
    "properties": {
      "created_at": {
        "type": "string",
        "format": "date-time"
      },
      "type": {
        "type": "string"
      }
    }
  },
  "MasterStateUpdateRequest": {
    "type": "object",
    "required": ["type"],
    "properties": {
      "type": {
        "type": "string"
      }
    }
  },
  "ColorTargetType": {
    "type": "string",
    "description": "背景色を設定する対象の種類",
    "enum": ["Item", "ItemType"],
    "x-enum-varnames": ["ColorTargetTypeItem", "ColorTargetTypeItemType"]
  },
  "ColorScreen": {
    "type": "string",
    "description": "背景色を適用する画面。\ncashier はレジのメニューのボタン、cashier_order はレジの過去の注文のカード、\nmaster・serve はマスター・提供画面のカップ\n",
    "enum": ["cashier", "cashier_order", "master", "serve"],
    "x-enum-varnames": [
      "ColorScreenCashier",
      "ColorScreenCashierOrder",
      "ColorScreenMaster",
      "ColorScreenServe"
    ]
  },
  "ColorSettingResponse": {
    "type": "object",
    "required": ["id", "target_type", "target_id", "screen", "color"],
    "properties": {
      "id": {
        "type": "string",
        "format": "uuid"
      },
      "target_type": {
        "$ref": "#/components/schemas/ColorTargetType"
      },
      "target_id": {
        "type": "string",
        "format": "uuid",
        "description": "Item または ItemType の ID"
      },
      "screen": {
        "$ref": "#/components/schemas/ColorScreen"
      },
      "color": {
        "type": "string",
        "pattern": "^#[0-9a-fA-F]{6}$",
        "example": "#bfdbfe"
      }
    }
  },
  "ColorSettingUpsertRequest": {
    "type": "object",
    "required": ["target_type", "target_id", "screen", "color"],
    "properties": {
      "target_type": {
        "$ref": "#/components/schemas/ColorTargetType"
      },
      "target_id": {
        "type": "string",
        "format": "uuid",
        "description": "Item または ItemType の ID"
      },
      "screen": {
        "$ref": "#/components/schemas/ColorScreen"
      },
      "color": {
        "type": "string",
        "pattern": "^#[0-9a-fA-F]{6}$",
        "example": "#bfdbfe"
      }
    }
  },
  "CashierStateResponse": {
    "type": "object",
    "required": ["editting_order", "submitted_order_id", "updated_at"],
    "properties": {
      "editting_order": {
        "type": "object",
        "additionalProperties": true,
        "description": "レジで編集中の注文。フロントの orderSchema の JSON をそのまま保持し、サーバーは上の階層のキーと型を確かめる以外は中身を解釈しない"
      },
      "submitted_order_id": {
        "type": "string",
        "format": "uuid",
        "nullable": true,
        "description": "直前に確定した注文の ID。編集中は null"
      },
      "updated_at": {
        "type": "string",
        "format": "date-time"
      }
    }
  },
  "CashierStateUpdateRequest": {
    "type": "object",
    "required": ["editting_order", "submitted_order_id"],
    "properties": {
      "editting_order": {
        "type": "object",
        "additionalProperties": true
      },
      "submitted_order_id": {
        "type": "string",
        "format": "uuid",
        "nullable": true
      }
    }
  },
  "CaosCupState": {
    "type": "object",
    "description": "カップの今の CaOS の値（OrderCupResponse の同じ名前の列をそのまま）。全部 null なら未割当",
    "required": [
      "dripper",
      "dripper_position",
      "drip_id",
      "brew_started_at",
      "brew_finished_at"
    ],
    "properties": {
      "dripper": {
        "type": "integer",
        "nullable": true,
        "minimum": 1,
        "maximum": 6
      },
      "dripper_position": {
        "type": "integer",
        "nullable": true
      },
      "drip_id": {
        "type": "string",
        "format": "uuid",
        "nullable": true
      },
      "brew_started_at": {
        "type": "string",
        "format": "date-time",
        "nullable": true
      },
      "brew_finished_at": {
        "type": "string",
        "format": "date-time",
        "nullable": true
      }
    }
  },
  "CaosCupAfter": {
    "type": "object",
    "description": "CaOS がカップに書く値。順番の数と抽出の時刻は送らない（順番はサーバーが insert_before から決め、開始・終了の時刻はサーバーの今で付ける）。\nstart_brew が true なら抽出を始める（brew_started_at にサーバーの今を入れる）。false なら待機・未割当（brew_started_at・brew_finished_at は null）。\ndripper・drip_id・insert_before が全部 null で start_brew が false なら未割当\n",
    "required": ["dripper", "drip_id", "insert_before", "start_brew"],
    "properties": {
      "dripper": {
        "type": "integer",
        "nullable": true,
        "minimum": 1,
        "maximum": 6
      },
      "drip_id": {
        "type": "string",
        "format": "uuid",
        "nullable": true
      },
      "insert_before": {
        "type": "string",
        "format": "uuid",
        "nullable": true,
        "description": "dripper の待機の、どのカード（drip_id）の前に入れるか。null なら最後。先頭に割り込むときは先頭のカードの drip_id。\ndripper が null（未割当）のときと、ほかのカップのカードに入る（統合）ときは null\n"
      },
      "start_brew": {
        "type": "boolean",
        "description": "抽出を始める（空いているドリッパーに置いてそのまま始める）。時刻はサーバーの今"
      }
    }
  },
  "CaosCupsWrite": {
    "type": "object",
    "description": "カップの組を before から after にする。before はカップの今の値（注文の応答の値をそのまま送り返す。時刻はミリ秒までで比べる）。\n抽出中・終わりのカップ（brew_started_at のあるカップ）は書けない（終えるのは「次へ」）\n",
    "required": ["cup_ids", "before", "after"],
    "properties": {
      "cup_ids": {
        "type": "array",
        "minItems": 1,
        "items": {
          "type": "string",
          "format": "uuid"
        }
      },
      "before": {
        "$ref": "#/components/schemas/CaosCupState"
      },
      "after": {
        "$ref": "#/components/schemas/CaosCupAfter"
      }
    }
  },
  "CaosCupsWriteRequest": {
    "type": "object",
    "required": ["writes"],
    "properties": {
      "writes": {
        "type": "array",
        "minItems": 1,
        "items": {
          "$ref": "#/components/schemas/CaosCupsWrite"
        }
      }
    }
  },
  "CaosNextRequest": {
    "type": "object",
    "required": ["drip_id"],
    "properties": {
      "drip_id": {
        "type": "string",
        "format": "uuid",
        "nullable": true,
        "description": "画面が抽出中と見ているカードの drip_id。抽出中が無いと見ているなら null"
      }
    }
  },
  "ErrorResponse": {
    "type": "object",
    "required": ["error"],
    "properties": {
      "error": {
        "type": "string",
        "example": "Invalid order ID format"
      }
    }
  },
  "StockResourceKind": {
    "type": "string",
    "enum": ["cup", "bean"],
    "x-enum-varnames": ["StockResourceKindCup", "StockResourceKindBean"]
  },
  "StockResourceRequest": {
    "type": "object",
    "required": [
      "kind",
      "name",
      "unit",
      "per_serving",
      "notify_from",
      "notify_step",
      "buffer"
    ],
    "properties": {
      "kind": {
        "$ref": "#/components/schemas/StockResourceKind"
      },
      "name": {
        "type": "string",
        "example": "ホットカップ"
      },
      "unit": {
        "type": "string",
        "description": "数える単位（個 / g）",
        "example": "個"
      },
      "per_serving": {
        "type": "number",
        "format": "double",
        "description": "1杯あたりの量。残量を杯数に換算するのに使う（カップ 1、豆 15）",
        "example": 1
      },
      "notify_from": {
        "type": "integer",
        "description": "残りがこの杯数を切ったら通知を始める",
        "example": 500
      },
      "notify_step": {
        "type": "integer",
        "description": "notify_from から何杯減るごとに通知するか",
        "example": 100
      },
      "buffer": {
        "type": "integer",
        "description": "最低限残したい杯数。これを切ると危険扱い",
        "example": 100
      }
    }
  },
  "StockResourceResponse": {
    "allOf": [
      {
        "$ref": "#/components/schemas/StockResourceRequest"
      },
      {
        "type": "object",
        "required": ["id"],
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          }
        }
      }
    ]
  },
  "InventoryLevel": {
    "type": "string",
    "description": "untracked は棚卸し・入荷がまだ一度も無い",
    "enum": ["ok", "warning", "critical", "untracked"],
