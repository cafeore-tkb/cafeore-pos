        "example": "#bfdbfe"
      }
    }
  },
  "CashierStateResponse": {
    "type": "object",
    "required": ["editting_order", "submitted_order_id", "updated_at"],
    "properties": {
      "editting_order": {
        "type": "object",
        "additionalProperties": true,
        "description": "レジで編集中の注文。フロントの orderSchema の JSON をそのまま保持し、サーバーは上の階層のキーと型を確かめる以外は中身を解釈しない"
      },
      "submitted_order_id": {
        "type": "string",
        "format": "uuid",
        "nullable": true,
        "description": "直前に確定した注文の ID。編集中は null"
      },
      "updated_at": {
        "type": "string",
        "format": "date-time"
      }
    }
  },
  "CashierStateUpdateRequest": {
    "type": "object",
    "required": ["editting_order", "submitted_order_id"],
    "properties": {
      "editting_order": {
        "type": "object",
        "additionalProperties": true
      },
      "submitted_order_id": {
        "type": "string",
        "format": "uuid",
        "nullable": true
      }
    }
  },
  "CaosCardStatus": {
    "type": "string",
    "enum": ["unassigned", "queued", "brewing", "done"],
    "x-enum-varnames": [
      "CaosCardStatusUnassigned",
      "CaosCardStatusQueued",
      "CaosCardStatusBrewing",
      "CaosCardStatusDone"
    ],
    "description": "unassigned＝未割当（保存しない） / queued＝列の待機 / brewing＝抽出中（1 つの列に 1 枚） / done＝終了"
  },
  "CaosCardCup": {
    "type": "object",
    "description": "カードの中の 1 杯。商品・注文番号・指名は注文（/api/ws/orders の orders）のカップから引く",
    "required": ["id", "emergency_at"],
    "properties": {
      "id": {
        "type": "string",
        "format": "uuid",
        "description": "注文のカップの ID"
      },
      "emergency_at": {
        "type": "string",
        "format": "date-time",
        "nullable": true,
        "description": "緊急（入れ直し）にした時刻"
      }
    }
  },
  "CaosCard": {
    "type": "object",
    "description": "CaOS の盤面のカード。1 回のドリップ（最大 2 杯）が 1 枚。\n未割当のカードは保存せず、まだカードに入っていないカップから組み立てる（id は null。cups の ID の組で指す）。\n緊急のカード（入れ直し）は emergency が true で、未割当でも待機でもいちばん上に並ぶ。\n",
    "required": [
      "id",
      "status",
      "lane",
      "position",
      "emergency",
      "interrupted",
      "started_at",
      "finished_at",
      "cups"
    ],
    "properties": {
      "id": {
        "type": "string",
        "format": "uuid",
        "nullable": true,
        "description": "保存したカードの ID。未割当のカードは null（統合した未割当のカードだけはカップに入れた ID を持つ）"
      },
      "status": {
        "$ref": "#/components/schemas/CaosCardStatus"
      },
      "lane": {
        "type": "integer",
        "nullable": true,
        "minimum": 1,
        "maximum": 6,
        "description": "担当の列（1〜6）。未割当は null"
      },
      "position": {
        "type": "number",
        "format": "double",
        "description": "並び。待機は列の中の順番（小さいほど先。ふつうは注文番号）、未割当は表示の順（0 から）"
      },
      "emergency": {
        "type": "boolean",
        "description": "緊急（入れ直し）のカード"
      },
      "interrupted": {
        "type": "boolean",
        "description": "緊急のために途中でやめた抽出"
      },
      "started_at": {
        "type": "string",
        "format": "date-time",
        "nullable": true
      },
      "finished_at": {
        "type": "string",
        "format": "date-time",
        "nullable": true
      },
      "cups": {
        "type": "array",
        "items": {
          "$ref": "#/components/schemas/CaosCardCup"
        }
      }
    }
  },
  "CaosCardRef": {
    "type": "object",
    "description": "カードの指し方。保存したカードは id、未割当のカードは cups の ID の組（cup_ids）。配られたカードの id と cups をそのまま送ればよい",
    "properties": {
      "id": {
        "type": "string",
        "format": "uuid",
        "nullable": true
      },
      "cup_ids": {
        "type": "array",
        "items": {
          "type": "string",
          "format": "uuid"
        }
      }
    }
  },
  "CaosOpName": {
    "type": "string",
    "enum": ["assign", "unassign", "next", "merge", "emergency", "undo"],
    "x-enum-varnames": [
      "CaosOpNameAssign",
      "CaosOpNameUnassign",
      "CaosOpNameNext",
      "CaosOpNameMerge",
      "CaosOpNameEmergency",
      "CaosOpNameUndo"
    ]
  },
  "CaosOp": {
    "type": "object",
    "description": "盤面への操作。name で選び、使うものだけを送る。\n- assign：card を lane へ（未割当→待機、待機→別の列・列の中の順番の入れ替え）。index は列の待機の中の位置（0 始まり。緊急とふつうはそれぞれの中で数える）。無ければ注文番号の順。列が空いていればそのまま抽出を始める\n- unassign：待機の card を未割当に戻す\n- next：lane の抽出中のカードを終わらせ、そのカップを準備完了にして、待機の次を始める。card を付けると、それが今の抽出中のときだけ終わらせる\n- merge：1 杯の card と with（未割当どうし・待機どうし、同じ商品・同じ指名）を 2 杯の同時抽出にまとめる\n- emergency：抽出中か終了のカードのカップ（cup_ids）を緊急にする。interrupt なら抽出中のカードを中断し、そのカードのカップを全部緊急にする\n- undo：op_id の操作を 1 つ戻す\n",
    "required": ["name"],
    "properties": {
      "name": {
        "$ref": "#/components/schemas/CaosOpName"
      },
      "card": {
        "$ref": "#/components/schemas/CaosCardRef"
      },
      "with": {
        "$ref": "#/components/schemas/CaosCardRef"
      },
      "lane": {
        "type": "integer",
        "minimum": 1,
        "maximum": 6
      },
      "index": {
        "type": "integer",
        "minimum": 0
      },
      "cup_ids": {
        "type": "array",
        "items": {
          "type": "string",
          "format": "uuid"
        }
      },
      "interrupt": {
        "type": "boolean"
      },
      "op_id": {
        "type": "string",
        "format": "uuid"
      }
    }
  },
  "CaosOpResult": {
    "type": "object",
    "required": ["op_id"],
    "properties": {
      "op_id": {
        "type": "string",
        "format": "uuid",
        "nullable": true,
        "description": "この操作の記録の ID（「1つ戻す」で送る）。何も変わらなかった操作と undo では null"
      }
    }
  },
  "ErrorResponse": {
    "type": "object",
    "required": ["error"],
    "properties": {
      "error": {
        "type": "string",
        "example": "Invalid order ID format"
      }
    }
  },
  "StockResourceKind": {
    "type": "string",
    "enum": ["cup", "bean"],
    "x-enum-varnames": ["StockResourceKindCup", "StockResourceKindBean"]
  },
  "StockResourceRequest": {
    "type": "object",
    "required": [
      "kind",
      "name",
      "unit",
      "per_serving",
      "notify_from",
      "notify_step",
      "buffer"
    ],
    "properties": {
      "kind": {
        "$ref": "#/components/schemas/StockResourceKind"
      },
      "name": {
        "type": "string",
        "example": "ホットカップ"
      },
      "unit": {
        "type": "string",
        "description": "数える単位（個 / g）",
        "example": "個"
      },
      "per_serving": {
        "type": "number",
        "format": "double",
        "description": "1杯あたりの量。残量を杯数に換算するのに使う（カップ 1、豆 15）",
        "example": 1
      },
      "notify_from": {
        "type": "integer",
        "description": "残りがこの杯数を切ったら通知を始める",
        "example": 500
      },
      "notify_step": {
        "type": "integer",
        "description": "notify_from から何杯減るごとに通知するか",
        "example": 100
      },
      "buffer": {
