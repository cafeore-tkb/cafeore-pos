{
  "StatusResponse": {
    "type": "object",
    "required": ["status", "timestamp", "version", "database"],
    "properties": {
      "status": {
        "type": "string",
        "example": "ok"
      },
      "timestamp": {
        "type": "string",
        "format": "date-time"
      },
      "version": {
        "type": "string",
        "example": "1.0.0"
      },
      "database": {
        "type": "string",
        "example": "connected"
      }
    }
  },
  "ItemResponse": {
    "type": "object",
    "required": ["id", "name", "abbr", "item_type"],
    "properties": {
      "id": {
        "type": "string",
        "format": "uuid"
      },
      "name": {
        "type": "string"
      },
      "abbr": {
        "type": "string"
      },
      "item_type": {
        "$ref": "#/components/schemas/ItemTypeResponse"
      }
    }
  },
  "ItemCreateRequest": {
    "type": "object",
    "required": ["name", "abbr", "item_type_id"],
    "properties": {
      "name": {
        "type": "string"
      },
      "abbr": {
        "type": "string"
      },
      "item_type_id": {
        "type": "string",
        "format": "uuid"
      }
    }
  },
  "ItemUpdateRequest": {
    "type": "object",
    "required": ["id", "name", "abbr", "item_type_id"],
    "properties": {
      "id": {
        "type": "string",
        "format": "uuid"
      },
      "name": {
        "type": "string"
      },
      "abbr": {
        "type": "string"
      },
      "item_type_id": {
        "type": "string",
        "format": "uuid"
      }
    }
  },
  "MenuItemResponse": {
    "type": "object",
    "required": ["item", "quantity"],
    "properties": {
      "item": {
        "$ref": "#/components/schemas/ItemResponse"
      },
      "quantity": {
        "type": "integer",
        "minimum": 1
      }
    }
  },
  "MenuItemRequest": {
    "type": "object",
    "required": ["item_id", "quantity"],
    "properties": {
      "item_id": {
        "type": "string",
        "format": "uuid"
      },
      "quantity": {
        "type": "integer",
        "minimum": 1
      }
    }
  },
  "MenuResponse": {
    "type": "object",
    "required": ["id", "name", "abbr", "price", "key", "items"],
    "properties": {
      "id": {
        "type": "string",
        "format": "uuid"
      },
      "name": {
        "type": "string"
      },
      "abbr": {
        "type": "string"
      },
      "price": {
        "type": "integer"
      },
      "key": {
        "type": "string"
      },
      "items": {
        "type": "array",
        "items": {
          "$ref": "#/components/schemas/MenuItemResponse"
        }
      }
    }
  },
  "MenuCreateRequest": {
    "type": "object",
    "required": ["name", "abbr", "price", "key", "items"],
    "properties": {
      "name": {
        "type": "string"
      },
      "abbr": {
        "type": "string"
      },
      "price": {
        "type": "integer",
        "minimum": 0
      },
      "key": {
        "type": "string"
      },
      "items": {
        "type": "array",
        "minItems": 1,
        "items": {
          "$ref": "#/components/schemas/MenuItemRequest"
        }
      }
    }
  },
  "MenuUpdateRequest": {
    "allOf": [
      {
        "$ref": "#/components/schemas/MenuCreateRequest"
      },
      {
        "type": "object",
        "required": ["id"],
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          }
        }
      }
    ]
  },
  "ItemTypeResponse": {
    "type": "object",
    "required": ["id", "name", "display_name"],
    "properties": {
      "id": {
        "type": "string",
        "format": "uuid"
      },
      "name": {
        "type": "string"
      },
      "display_name": {
        "type": "string"
      }
    }
  },
  "ItemTypeCreateRequest": {
    "type": "object",
    "required": ["name", "display_name"],
    "properties": {
      "name": {
        "type": "string"
      },
      "display_name": {
        "type": "string"
      }
    }
  },
  "ItemTypeUpdateRequest": {
    "type": "object",
    "required": ["id", "name", "display_name"],
    "properties": {
      "id": {
        "type": "string",
        "format": "uuid"
      },
      "name": {
        "type": "string"
      },
      "display_name": {
        "type": "string"
      }
    }
  },
  "MenuInfo": {
    "type": "object",
    "required": [
      "id",
      "menu_name",
      "unit_price",
      "menu",
      "assignee",
      "dripper"
    ],
    "properties": {
      "id": {
        "type": "string",
        "format": "uuid",
        "description": "注文明細ID"
      },
      "menu_name": {
        "type": "string",
        "description": "注文時点のメニュー名"
      },
      "unit_price": {
        "type": "integer",
        "description": "注文時点のメニュー価格"
      },
      "menu": {
        "$ref": "#/components/schemas/MenuResponse"
      },
      "assignee": {
        "type": "string",
        "nullable": true,
        "description": "指名の自由記述（ラベルに印刷する文）。dripper が無い明細では null。番号より前の注文は自由記述だけのことがある"
      },
      "dripper": {
        "type": "integer",
        "minimum": 1,
        "maximum": 6,
        "nullable": true,
        "description": "指名したドリッパーの番号（1st〜6th は 1〜6）。指名しない明細は null"
      }
    }
  },
  "OrderCupResponse": {
    "type": "object",
    "required": ["id", "order_menu_id", "item", "ready_at", "served_at"],
    "properties": {
      "id": {
        "type": "string",
        "format": "uuid"
      },
      "order_menu_id": {
        "type": "string",
        "format": "uuid",
        "description": "このカップを含む注文明細のID（MenuInfo.id）"
      },
      "item": {
        "$ref": "#/components/schemas/ItemResponse"
      },
      "ready_at": {
        "type": "string",
        "format": "date-time",
        "nullable": true,
        "description": "このカップが準備完了になった時刻。未準備なら null"
      },
      "served_at": {
        "type": "string",
        "format": "date-time",
        "nullable": true,
        "description": "このカップを提供した時刻。未提供なら null"
      }
    }
  },
  "MenuInfoCreate": {
    "type": "object",
    "required": ["menu_id", "assignee", "dripper"],
    "properties": {
      "order_menu_id": {
        "type": "string",
        "format": "uuid",
        "description": "更新時に残す既存明細のID。新規明細では省略する。価格・名称はサーバーが保存する。"
      },
      "menu_id": {
        "type": "string",
        "format": "uuid"
      },
      "assignee": {
        "type": "string",
        "nullable": true,
        "description": "指名の自由記述。新しい明細では dripper が無いと付けられない。空白だけなら null として扱う"
      },
      "dripper": {
        "type": "integer",
        "minimum": 1,
        "maximum": 6,
        "nullable": true,
        "description": "指名したドリッパーの番号（1〜6）。指名しない明細は null"
      }
    }
  },
  "OrderResponse": {
    "type": "object",
    "required": [
      "id",
      "order_id",
      "created_at",
      "billing_amount",
      "received",
      "menus",
      "cups"
    ],
    "properties": {
      "id": {
        "type": "string",
        "format": "uuid"
      },
      "order_id": {
        "type": "integer"
      },
      "created_at": {
        "type": "string",
        "format": "date-time"
      },
      "ready_at": {
        "type": "string",
        "format": "date-time",
        "nullable": true
      },
      "served_at": {
        "type": "string",
        "format": "date-time",
        "nullable": true
      },
      "billing_amount": {
        "type": "integer"
      },
      "received": {
        "type": "integer"
      },
      "discount_order_id": {
        "type": "integer",
        "nullable": true
      },
      "discount_order_cups": {
        "type": "integer"
      },
      "menus": {
        "type": "array",
        "items": {
          "$ref": "#/components/schemas/MenuInfo"
        }
      },
      "cups": {
        "type": "array",
        "description": "注文のカップ（1杯ずつ）。注文した順に並ぶ。グッズだけの注文では空",
        "items": {
          "$ref": "#/components/schemas/OrderCupResponse"
        }
      },
      "comments": {
        "type": "array",
        "items": {
          "$ref": "#/components/schemas/CommentResponse"
        }
      }
    }
  },
  "OrderCreateRequest": {
    "type": "object",
    "required": ["order_id", "billing_amount", "received", "menu_ids"],
    "properties": {
      "order_id": {
        "type": "integer",
        "example": 1
      },
      "billing_amount": {
        "type": "integer",
        "example": 500
      },
      "received": {
        "type": "integer",
        "example": 500,
        "default": 0
      },
      "discount_order_id": {
        "type": "integer",
        "nullable": true
      },
      "discount_order_cups": {
        "type": "integer",
        "default": 0
      },
      "menu_ids": {
        "type": "array",
        "items": {
          "$ref": "#/components/schemas/MenuInfoCreate"
        }
      },
      "comments": {
        "type": "array",
        "items": {
          "$ref": "#/components/schemas/CommentCreateRequest"
        }
      }
    }
  },
  "OrderUpdateRequest": {
    "type": "object",
    "required": ["id", "order_id", "billing_amount", "received", "menu_ids"],
    "properties": {
      "id": {
        "type": "string",
        "format": "uuid"
      },
      "order_id": {
        "type": "integer"
      },
      "ready_at": {
        "type": "string",
        "format": "date-time",
        "nullable": true
      },
      "served_at": {
        "type": "string",
        "format": "date-time",
        "nullable": true
      },
      "billing_amount": {
        "type": "integer"
      },
      "received": {
        "type": "integer"
      },
      "discount_order_id": {
        "type": "integer",
        "nullable": true
      },
      "discount_order_cups": {
        "type": "integer"
      },
      "menu_ids": {
        "type": "array",
        "items": {
          "$ref": "#/components/schemas/MenuInfoCreate"
        }
      }
    }
  },
  "OrderListItem": {
    "type": "object",
    "required": ["id", "order_id", "created_at", "billing_amount"],
    "properties": {
      "id": {
        "type": "string",
        "format": "uuid"
      },
      "order_id": {
        "type": "integer"
      },
      "created_at": {
        "type": "string",
        "format": "date-time"
      },
      "ready_at": {
        "type": "string",
        "format": "date-time",
        "nullable": true
      },
      "served_at": {
        "type": "string",
        "format": "date-time",
        "nullable": true
      },
      "billing_amount": {
        "type": "integer"
      },
      "received": {
        "type": "integer"
      },
      "discount_order_cups": {
        "type": "integer"
      }
    }
  },
  "CommentCreateRequest": {
    "type": "object",
    "required": ["author", "text"],
    "properties": {
      "author": {
        "type": "string"
      },
      "text": {
        "type": "string"
      }
    }
  },
  "CommentResponse": {
    "type": "object",
    "required": ["order_id", "author", "text", "created_at"],
    "properties": {
      "order_id": {
        "type": "string",
        "format": "uuid"
      },
      "author": {
        "type": "string"
      },
      "text": {
        "type": "string"
      },
      "created_at": {
        "type": "string",
        "format": "date-time"
      }
    }
  },
  "MasterStateResponse": {
    "type": "object",
    "required": ["created_at", "type"],
    "properties": {
      "created_at": {
        "type": "string",
        "format": "date-time"
      },
      "type": {
        "type": "string"
      }
    }
  },
  "MasterStateUpdateRequest": {
    "type": "object",
    "required": ["type"],
    "properties": {
      "type": {
        "type": "string"
      }
    }
  },
  "ColorTargetType": {
    "type": "string",
    "description": "背景色を設定する対象の種類",
    "enum": ["Item", "ItemType"],
    "x-enum-varnames": ["ColorTargetTypeItem", "ColorTargetTypeItemType"]
  },
  "ColorScreen": {
    "type": "string",
    "description": "背景色を適用する画面",
    "enum": ["cashier", "master", "serve"],
    "x-enum-varnames": [
      "ColorScreenCashier",
      "ColorScreenMaster",
      "ColorScreenServe"
    ]
  },
  "ColorSettingResponse": {
    "type": "object",
    "required": ["id", "target_type", "target_id", "screen", "color"],
    "properties": {
      "id": {
        "type": "string",
        "format": "uuid"
      },
      "target_type": {
        "$ref": "#/components/schemas/ColorTargetType"
      },
      "target_id": {
        "type": "string",
        "format": "uuid",
        "description": "Item または ItemType の ID"
      },
      "screen": {
        "$ref": "#/components/schemas/ColorScreen"
      },
      "color": {
        "type": "string",
        "pattern": "^#[0-9a-fA-F]{6}$",
        "example": "#bfdbfe"
      }
    }
  },
  "ColorSettingUpsertRequest": {
    "type": "object",
    "required": ["target_type", "target_id", "screen", "color"],
    "properties": {
      "target_type": {
        "$ref": "#/components/schemas/ColorTargetType"
      },
      "target_id": {
        "type": "string",
        "format": "uuid",
        "description": "Item または ItemType の ID"
      },
      "screen": {
        "$ref": "#/components/schemas/ColorScreen"
      },
      "color": {
        "type": "string",
        "pattern": "^#[0-9a-fA-F]{6}$",
        "example": "#bfdbfe"
      }
    }
  },
  "CaosDripLine": {
    "type": "object",
    "description": "抽出カードの中身の 1 行。注文番号や商品名は持たない（/api/ws/orders の注文から引く）",
    "required": ["order_id", "item_id", "dripper", "cups"],
    "properties": {
      "order_id": {
        "type": "string",
        "format": "uuid"
      },
      "item_id": {
        "type": "string",
        "format": "uuid"
      },
      "dripper": {
        "type": "integer",
        "minimum": 1,
        "maximum": 6,
        "nullable": true,
        "description": "指名したドリッパーの番号（POS の明細の dripper。1st〜6th は 1〜6）。指名なしは null。同じ商品でも指名ごとにカードを分ける。番号の無い自由記述だけの古い明細は指名なし。カードの担当（CaosDrip.dripper）とは別"
      },
      "cups": {
        "type": "integer",
        "minimum": 1,
        "maximum": 2
      }
    }
  },
  "CaosDripStatus": {
    "type": "string",
    "enum": ["unassigned", "queued", "brewing", "done"],
    "x-enum-varnames": [
      "CaosDripStatusUnassigned",
      "CaosDripStatusQueued",
      "CaosDripStatusBrewing",
      "CaosDripStatusDone"
    ],
    "description": "unassigned＝未割当 / queued＝担当の待機列 / brewing＝抽出中（1 人 1 枚） / done＝抽出終了"
  },
  "CaosDrip": {
    "type": "object",
    "description": "抽出カード。1 回のドリップ（最大 2 杯）が 1 枚。order_ids と cups は lines から求めたもの",
    "required": [
      "id",
      "status",
      "dripper",
      "queue_pos",
      "order_ids",
      "lines",
      "cups",
      "rebrew_of",
      "interrupted",
      "started_at",
      "finished_at",
      "created_at",
      "updated_at"
    ],
    "properties": {
      "id": {
        "type": "string",
        "format": "uuid"
      },
      "status": {
        "$ref": "#/components/schemas/CaosDripStatus"
      },
      "dripper": {
        "type": "integer",
        "nullable": true,
        "minimum": 1,
        "maximum": 6
      },
      "queue_pos": {
        "type": "number",
        "format": "double",
        "description": "待機列の並び順（ふだんは注文番号）"
      },
      "order_ids": {
        "type": "array",
        "items": {
          "type": "string",
          "format": "uuid"
        }
      },
      "lines": {
        "type": "array",
        "items": {
          "$ref": "#/components/schemas/CaosDripLine"
        }
      },
      "cups": {
        "type": "integer",
        "minimum": 1,
        "maximum": 2
      },
      "rebrew_of": {
        "type": "string",
        "format": "uuid",
        "nullable": true,
        "description": "入れ直しのカードなら、元のカード"
      },
      "interrupted": {
        "type": "boolean",
        "description": "入れ直しのために途中でやめた抽出"
      },
      "started_at": {
        "type": "string",
        "format": "date-time",
        "nullable": true
      },
      "finished_at": {
        "type": "string",
        "format": "date-time",
        "nullable": true
      },
      "created_at": {
        "type": "string",
        "format": "date-time"
      },
      "updated_at": {
        "type": "string",
        "format": "date-time",
        "description": "「1つ戻す」は、この値が操作の記録と同じとき（ほかの端末が触っていないとき）だけ戻す"
      }
    }
  },
  "CaosLane": {
    "type": "object",
    "description": "列（ドリッパー 1〜6）の担当者。営業日ごとに持ち、配信では 1〜6 の 6 列が必ずそろう。担当者がいない列は name が空。\nsenior は交代したときに画面が sohosai-shift の名簿（seniors）で判定したもの（名簿を読めない端末でも同じ表示になるように持つ）。\n",
    "required": ["dripper", "name", "senior", "updated_at"],
    "properties": {
      "dripper": {
        "type": "integer",
        "minimum": 1,
        "maximum": 6
      },
      "name": {
        "type": "string",
        "description": "担当者の名前（前後の空白を落としたもの）。空なら担当者なし"
      },
      "senior": {
        "type": "boolean",
        "description": "上級生（限定を淹れられる）か。担当者がいない列は false"
      },
      "updated_at": {
        "type": "string",
        "format": "date-time",
        "nullable": true,
        "description": "最後に替えた時刻。一度も替えていない列は null（「1つ戻す」は、この値が操作の記録と同じときだけ戻す）"
      }
    }
  },
  "CaosOp": {
    "type": "object",
    "description": "name ごとに使うフィールド：\nassign（drip_id・dripper）/ unassign（drip_id）/ next（dripper。drip_id は任意で、終わらせるカード。今抽出中のカードと違えば 422）/ merge（first_id・second_id）/\nrebrew（source_id・cups・interrupt・dripper（null なら未割当）・queue_pos（null なら元の位置））/\nset_lane（dripper・person（空なら担当者なし）・senior）/ swap_lanes（dripper・other_dripper）/\nundo（op_id）\n",
    "required": ["name"],
    "properties": {
      "name": {
        "type": "string",
        "enum": [
          "assign",
          "unassign",
          "next",
          "merge",
          "rebrew",
          "set_lane",
          "swap_lanes",
          "undo"
        ],
        "x-enum-varnames": [
          "CaosOpAssign",
          "CaosOpUnassign",
          "CaosOpNext",
          "CaosOpMerge",
          "CaosOpRebrew",
          "CaosOpSetLane",
          "CaosOpSwapLanes",
          "CaosOpUndo"
        ]
      },
      "drip_id": {
        "type": "string",
        "format": "uuid"
      },
      "dripper": {
        "type": "integer",
        "nullable": true,
        "minimum": 1,
        "maximum": 6
      },
      "first_id": {
        "type": "string",
        "format": "uuid"
      },
      "second_id": {
        "type": "string",
        "format": "uuid"
      },
      "source_id": {
        "type": "string",
        "format": "uuid"
      },
      "cups": {
        "type": "integer",
        "minimum": 1,
        "maximum": 2,
        "description": "入れ直す杯数（元のカードの杯数まで）"
      },
      "interrupt": {
        "type": "boolean",
        "description": "抽出中の元のカードを途中でやめる"
      },
      "queue_pos": {
        "type": "number",
        "format": "double",
        "nullable": true
      },
      "op_id": {
        "type": "string",
        "format": "uuid",
        "description": "undo で戻す操作（操作の結果の op_id）"
      },
      "person": {
        "type": "string",
        "maxLength": 40,
        "description": "set_lane の担当者の名前（前後の空白は落とす）。空なら担当者なし"
      },
      "senior": {
        "type": "boolean",
        "description": "set_lane の担当者が上級生（限定を淹れられる）か。画面が sohosai-shift の名簿で判定して送る"
      },
      "other_dripper": {
        "type": "integer",
        "minimum": 1,
        "maximum": 6,
        "description": "swap_lanes で dripper の列と担当者を入れ替える列"
      }
    }
  },
  "CaosOpResult": {
    "type": "object",
    "required": ["op_id", "changed", "deleted", "readied", "lanes"],
    "properties": {
