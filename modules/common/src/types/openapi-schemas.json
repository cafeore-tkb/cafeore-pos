      },
      "servings": {
        "type": "integer",
        "description": "counted_at 以降に売れた杯数"
      },
      "remaining": {
        "type": "number",
        "format": "double",
        "nullable": true
      },
      "remaining_servings": {
        "type": "number",
        "format": "double",
        "nullable": true
      },
      "servings_last_hour": {
        "type": "integer",
