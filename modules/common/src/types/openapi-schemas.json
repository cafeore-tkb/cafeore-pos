{
  "StatusResponse": {
    "type": "object",
    "required": ["status", "timestamp", "version", "database"],
    "properties": {
      "status": {
        "type": "string",
        "example": "ok"
      },
      "timestamp": {
        "type": "string",
        "format": "date-time"
      },
      "version": {
        "type": "string",
        "example": "1.0.0"
      },
      "database": {
        "type": "string",
        "example": "connected"
      },
      "build": {
        "$ref": "#/components/schemas/BuildInfo"
      }
    }
  },
  "BuildInfo": {
    "type": "object",
    "description": "このサーバーがどの PR・コミットからビルドされたか。CI がイメージを作るときに焼き込む。\nPOS のトップページに、画面のビルドと並べて出す。\nローカルで動かしたときは空。この項目より前のサーバーは build 自体を返さない。\n",
    "properties": {
      "pr": {
        "type": "integer",
        "description": "PR の番号。プレビューはその PR、本番はマージした PR。分からなければ省く",
        "example": 889
      },
      "commit": {
        "type": "string",
        "description": "コミットの SHA。プレビューは PR の head のコミット。分からなければ省く",
        "example": "90b89b2a1c3e4f5061728394a5b6c7d8e9f01234"
      }
    }
  },
  "ItemResponse": {
    "type": "object",
    "required": ["id", "name", "abbr", "item_type"],
    "properties": {
      "id": {
        "type": "string",
        "format": "uuid"
      },
      "name": {
        "type": "string"
      },
      "abbr": {
        "type": "string"
      },
      "item_type": {
        "$ref": "#/components/schemas/ItemTypeResponse"
      }
    }
  },
  "ItemCreateRequest": {
    "type": "object",
    "required": ["name", "abbr", "item_type_id"],
    "properties": {
      "name": {
        "type": "string"
      },
      "abbr": {
        "type": "string"
      },
      "item_type_id": {
        "type": "string",
        "format": "uuid"
      }
    }
  },
  "ItemUpdateRequest": {
    "type": "object",
    "required": ["id", "name", "abbr", "item_type_id"],
    "properties": {
      "id": {
        "type": "string",
        "format": "uuid"
      },
      "name": {
        "type": "string"
      },
      "abbr": {
        "type": "string"
      },
      "item_type_id": {
        "type": "string",
        "format": "uuid"
      }
    }
  },
  "MenuItemResponse": {
    "type": "object",
    "required": ["item", "quantity"],
    "properties": {
      "item": {
        "$ref": "#/components/schemas/ItemResponse"
      },
      "quantity": {
        "type": "integer",
        "minimum": 1
      }
    }
  },
  "MenuItemRequest": {
    "type": "object",
    "required": ["item_id", "quantity"],
    "properties": {
      "item_id": {
        "type": "string",
        "format": "uuid"
      },
      "quantity": {
        "type": "integer",
        "minimum": 1
      }
    }
  },
  "MenuResponse": {
    "type": "object",
    "required": ["id", "name", "abbr", "price", "key", "items"],
    "properties": {
      "id": {
        "type": "string",
        "format": "uuid"
      },
      "name": {
        "type": "string"
      },
      "abbr": {
        "type": "string"
      },
      "price": {
        "type": "integer"
      },
      "key": {
        "type": "string"
      },
      "items": {
        "type": "array",
        "items": {
          "$ref": "#/components/schemas/MenuItemResponse"
        }
      }
    }
  },
  "MenuCreateRequest": {
    "type": "object",
    "required": ["name", "abbr", "price", "key", "items"],
    "properties": {
      "name": {
        "type": "string"
      },
      "abbr": {
        "type": "string"
      },
      "price": {
        "type": "integer",
        "minimum": 0
      },
      "key": {
        "type": "string"
      },
      "items": {
        "type": "array",
        "minItems": 1,
        "items": {
          "$ref": "#/components/schemas/MenuItemRequest"
        }
      }
    }
  },
  "MenuUpdateRequest": {
    "allOf": [
      {
        "$ref": "#/components/schemas/MenuCreateRequest"
      },
      {
        "type": "object",
        "required": ["id"],
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          }
        }
      }
    ]
  },
  "ItemTypeResponse": {
    "type": "object",
    "required": [
      "id",
      "name",
      "display_name",
      "makes_cup",
      "needs_brew",
      "senior_only",
      "iced_brew"
    ],
    "properties": {
      "id": {
        "type": "string",
        "format": "uuid"
      },
      "name": {
        "type": "string"
      },
      "display_name": {
        "type": "string"
      },
      "makes_cup": {
        "type": "boolean",
        "description": "この種類のアイテムは1杯ずつカップを作る（注文のカップ・マスター・提供画面に出る）。グッズは false"
      },
      "needs_brew": {
        "type": "boolean",
        "description": "この種類のアイテムは抽出が要る（割引の対象の杯数・ドリッパーの割り振りに数える）。makes_cup が false なら必ず false"
      },
      "senior_only": {
        "type": "boolean",
        "description": "この種類のアイテムは上級生だけが淹れる。needs_brew が false なら必ず false"
      },
      "iced_brew": {
        "type": "boolean",
        "description": "この種類のアイテムはアイスで淹れる（CaOS でアイスに対応していないドリッパーに割り振らない）。needs_brew が false なら必ず false"
      }
    }
  },
  "ItemTypeCreateRequest": {
    "type": "object",
    "required": ["name", "display_name"],
    "properties": {
      "name": {
        "type": "string"
      },
      "display_name": {
        "type": "string"
      },
      "makes_cup": {
        "type": "boolean",
        "default": true,
        "description": "省略したら true"
      },
      "needs_brew": {
        "type": "boolean",
        "description": "省略したら makes_cup と同じ。makes_cup が false のときに true は 400"
      },
      "senior_only": {
        "type": "boolean",
        "default": false,
        "description": "省略したら false。needs_brew が false のときに true は 400"
      },
      "iced_brew": {
        "type": "boolean",
        "default": false,
        "description": "省略したら false。needs_brew が false のときに true は 400"
      }
    }
  },
  "ItemTypeUpdateRequest": {
    "type": "object",
    "required": ["id", "name", "display_name"],
    "properties": {
      "id": {
        "type": "string",
        "format": "uuid"
      },
      "name": {
        "type": "string"
      },
      "display_name": {
        "type": "string"
      },
      "makes_cup": {
        "type": "boolean",
        "description": "省略したら今の値のまま"
      },
      "needs_brew": {
        "type": "boolean",
        "description": "省略したら今の値のまま（makes_cup を false にしたときは false）。makes_cup が false のときに true は 400"
      },
      "senior_only": {
        "type": "boolean",
        "description": "省略したら今の値のまま（needs_brew が false になるときは false）。needs_brew が false のときに true は 400"
      },
      "iced_brew": {
        "type": "boolean",
        "description": "省略したら今の値のまま（needs_brew が false になるときは false）。needs_brew が false のときに true は 400"
      }
    }
  },
  "MenuInfo": {
    "type": "object",
    "required": [
      "id",
      "menu_name",
      "unit_price",
      "menu",
      "assignee",
      "dripper"
    ],
    "properties": {
      "id": {
        "type": "string",
        "format": "uuid",
        "description": "注文明細ID"
      },
      "menu_name": {
        "type": "string",
        "description": "注文時点のメニュー名"
      },
      "unit_price": {
        "type": "integer",
        "description": "注文時点のメニュー価格"
      },
      "menu": {
        "$ref": "#/components/schemas/MenuResponse"
      },
      "assignee": {
        "type": "string",
        "nullable": true,
        "description": "指名の自由記述（ラベルに印刷する文）。dripper が無い明細では null。番号より前の注文は自由記述だけのことがある"
      },
      "dripper": {
        "type": "integer",
        "minimum": 1,
        "maximum": 6,
        "nullable": true,
        "description": "指名したドリッパーの番号（1st〜6th は 1〜6）。指名しない明細は null"
      }
    }
  },
  "OrderCupResponse": {
    "type": "object",
    "required": [
      "id",
      "order_menu_id",
      "item",
      "ready_at",
      "served_at",
      "dripper",
      "dripper_position",
      "drip_id",
      "brew_started_at",
      "brew_finished_at",
      "emergencies"
    ],
    "properties": {
      "id": {
        "type": "string",
        "format": "uuid"
      },
      "order_menu_id": {
        "type": "string",
        "format": "uuid",
        "description": "このカップを含む注文明細のID（MenuInfo.id）"
      },
      "item": {
        "$ref": "#/components/schemas/ItemResponse"
      },
      "ready_at": {
        "type": "string",
        "format": "date-time",
        "nullable": true,
        "description": "このカップが準備完了になった時刻。未準備なら null"
      },
      "served_at": {
        "type": "string",
        "format": "date-time",
        "nullable": true,
        "description": "このカップを提供した時刻。未提供なら null"
      },
      "dripper": {
        "type": "integer",
        "nullable": true,
        "minimum": 1,
        "maximum": 6,
        "description": "CaOS が置いたドリッパーの番号（1〜6）。未割当なら null。以下の CaOS の列は CaOS 以外の画面は読まない"
      },
      "dripper_position": {
        "type": "integer",
        "nullable": true,
        "description": "CaOS のドリッパーの中の順番（小さいほど先）。サーバーが決める（途中に入れると後ろを +1 する。抜けた番号は詰めない）"
      },
      "drip_id": {
        "type": "string",
        "format": "uuid",
        "nullable": true,
        "description": "CaOS のカードの印。同じ値のカップを 1 枚のカード（1 回のドリップ）で淹れる"
      },
      "brew_started_at": {
        "type": "string",
        "format": "date-time",
        "nullable": true,
        "description": "CaOS で抽出を始めた時刻"
      },
      "brew_finished_at": {
        "type": "string",
        "format": "date-time",
        "nullable": true,
        "description": "CaOS で抽出を終えた時刻"
      },
      "emergencies": {
        "type": "array",
        "description": "このカップの緊急（入れ直し）。足した順。CaOS 以外の画面は読まない",
        "items": {
          "$ref": "#/components/schemas/CupEmergencyResponse"
        }
      }
    }
  },
  "CupEmergencyResponse": {
    "type": "object",
    "description": "緊急（入れ直し）1 回。CaOS の入れ直しのカードの列（意味は OrderCupResponse の同じ名前の列と同じ）",
    "required": [
      "id",
      "created_at",
      "dripper",
      "dripper_position",
      "drip_id",
      "brew_started_at",
      "brew_finished_at"
    ],
    "properties": {
      "id": {
        "type": "string",
        "format": "uuid"
      },
      "created_at": {
        "type": "string",
        "format": "date-time"
      },
      "dripper": {
        "type": "integer",
        "nullable": true,
        "minimum": 1,
        "maximum": 6
      },
      "dripper_position": {
        "type": "integer",
        "nullable": true
      },
      "drip_id": {
        "type": "string",
        "format": "uuid",
        "nullable": true
      },
      "brew_started_at": {
        "type": "string",
        "format": "date-time",
        "nullable": true
      },
      "brew_finished_at": {
        "type": "string",
        "format": "date-time",
        "nullable": true
      }
    }
  },
  "MenuInfoCreate": {
    "type": "object",
    "required": ["menu_id", "assignee", "dripper"],
    "properties": {
      "order_menu_id": {
        "type": "string",
        "format": "uuid",
        "description": "更新時に残す既存明細のID。新規明細では省略する。価格・名称はサーバーが保存する。"
      },
      "menu_id": {
        "type": "string",
        "format": "uuid"
      },
      "assignee": {
        "type": "string",
        "nullable": true,
        "description": "指名の自由記述。新しい明細では dripper が無いと付けられない。空白だけなら null として扱う"
      },
      "dripper": {
        "type": "integer",
        "minimum": 1,
        "maximum": 6,
        "nullable": true,
        "description": "指名したドリッパーの番号（1〜6）。指名しない明細は null"
      }
    }
  },
  "OrderResponse": {
    "type": "object",
    "required": [
      "id",
      "order_id",
      "created_at",
      "billing_amount",
      "received",
      "payment_method",
      "menus",
      "cups"
    ],
    "properties": {
      "id": {
        "type": "string",
        "format": "uuid"
      },
      "order_id": {
        "type": "integer"
      },
      "created_at": {
        "type": "string",
        "format": "date-time"
      },
      "ready_at": {
        "type": "string",
        "format": "date-time",
        "nullable": true
      },
      "served_at": {
        "type": "string",
        "format": "date-time",
        "nullable": true
      },
      "billing_amount": {
        "type": "integer"
      },
      "received": {
        "type": "integer"
      },
      "discount_order_id": {
        "type": "integer",
        "nullable": true
      },
      "discount_order_cups": {
        "type": "integer"
      },
      "payment_method": {
        "$ref": "#/components/schemas/PaymentMethod"
      },
      "menus": {
        "type": "array",
        "items": {
          "$ref": "#/components/schemas/MenuInfo"
        }
      },
      "cups": {
        "type": "array",
        "description": "注文のカップ（1杯ずつ）。注文した順に並ぶ。グッズだけの注文では空",
        "items": {
          "$ref": "#/components/schemas/OrderCupResponse"
        }
      },
      "comments": {
        "type": "array",
        "items": {
          "$ref": "#/components/schemas/CommentResponse"
        }
      }
    }
  },
  "OrderCreateRequest": {
    "type": "object",
    "required": ["order_id", "billing_amount", "received", "menu_ids"],
    "properties": {
      "order_id": {
        "type": "integer",
        "example": 1
      },
      "billing_amount": {
        "type": "integer",
        "example": 500
      },
      "received": {
        "type": "integer",
        "example": 500,
        "default": 0
      },
      "discount_order_id": {
        "type": "integer",
        "nullable": true
      },
      "discount_order_cups": {
        "type": "integer",
        "default": 0
      },
      "payment_method": {
        "$ref": "#/components/schemas/PaymentMethod"
      },
      "square_checkout_id": {
        "type": "string",
        "format": "uuid",
        "nullable": true,
        "description": "payment_method が square のとき必須。COMPLETED で金額が billing_amount と一致し、まだどの注文にも使われていない決済依頼の id。"
      },
      "menu_ids": {
        "type": "array",
        "items": {
          "$ref": "#/components/schemas/MenuInfoCreate"
        }
      },
      "comments": {
        "type": "array",
        "items": {
          "$ref": "#/components/schemas/CommentCreateRequest"
        }
      },
      "idempotency_key": {
        "type": "string",
        "format": "uuid",
        "description": "送り直しで同じ注文を二重に作らないためのキー。作る注文の ID にそのまま使い、この ID の注文がすでにあれば新しく作らずにその注文を 200 で返す。送り直しでは同じキーを送る。省略すると毎回新しい注文を作る"
      },
      "created_at": {
        "type": "string",
        "format": "date-time",
        "description": "レジで注文を確定した時刻。オフラインのあいだに溜めた注文を、つながってから送るときに付ける。省略するとサーバーの今。サーバーの今より未来の時刻はサーバーの今にする（端末の時計の進み）。古い時刻もそのまま受け付ける（前の日に溜めた注文も、確定した日の注文として残る）"
      }
    }
  },
  "OrderUpdateRequest": {
    "type": "object",
    "required": ["id", "order_id", "billing_amount", "received", "menu_ids"],
    "properties": {
      "id": {
        "type": "string",
        "format": "uuid"
      },
      "order_id": {
        "type": "integer"
      },
      "ready_at": {
        "type": "string",
        "format": "date-time",
        "nullable": true
      },
      "served_at": {
        "type": "string",
        "format": "date-time",
        "nullable": true
      },
      "billing_amount": {
        "type": "integer"
      },
      "received": {
        "type": "integer"
      },
      "discount_order_id": {
        "type": "integer",
        "nullable": true
      },
      "discount_order_cups": {
        "type": "integer"
      },
      "menu_ids": {
        "type": "array",
        "items": {
          "$ref": "#/components/schemas/MenuInfoCreate"
        }
      }
    }
  },
  "OrderListItem": {
    "type": "object",
    "required": ["id", "order_id", "created_at", "billing_amount"],
    "properties": {
      "id": {
        "type": "string",
        "format": "uuid"
      },
      "order_id": {
        "type": "integer"
      },
      "created_at": {
        "type": "string",
        "format": "date-time"
      },
      "ready_at": {
        "type": "string",
        "format": "date-time",
        "nullable": true
      },
      "served_at": {
        "type": "string",
        "format": "date-time",
        "nullable": true
      },
      "billing_amount": {
        "type": "integer"
      },
      "received": {
        "type": "integer"
      },
      "discount_order_cups": {
        "type": "integer"
      }
    }
  },
  "CommentCreateRequest": {
    "type": "object",
    "required": ["author", "text"],
    "properties": {
      "author": {
        "type": "string"
      },
      "text": {
        "type": "string"
      }
    }
  },
  "CommentResponse": {
    "type": "object",
    "required": ["order_id", "author", "text", "created_at"],
    "properties": {
      "order_id": {
        "type": "string",
        "format": "uuid"
      },
      "author": {
        "type": "string"
      },
      "text": {
        "type": "string"
      },
      "created_at": {
        "type": "string",
        "format": "date-time"
      }
    }
  },
  "MasterStateResponse": {
    "type": "object",
    "required": ["created_at", "type"],
    "properties": {
      "created_at": {
        "type": "string",
        "format": "date-time"
      },
      "type": {
        "type": "string"
      }
    }
  },
  "MasterStateUpdateRequest": {
    "type": "object",
    "required": ["type"],
    "properties": {
      "type": {
        "type": "string"
      }
    }
  },
  "ColorTargetType": {
    "type": "string",
    "description": "背景色を設定する対象の種類",
    "enum": ["Item", "ItemType"],
    "x-enum-varnames": ["ColorTargetTypeItem", "ColorTargetTypeItemType"]
  },
  "ColorScreen": {
    "type": "string",
    "description": "背景色を適用する画面。\ncashier はレジのメニューのボタン、cashier_order はレジの過去の注文のカード、\nmaster・serve はマスター・提供画面のカップ、caos_nominated は CaOS の指名のカード（無ければ master の色）\n",
    "enum": ["cashier", "cashier_order", "master", "serve", "caos_nominated"],
    "x-enum-varnames": [
      "ColorScreenCashier",
      "ColorScreenCashierOrder",
      "ColorScreenMaster",
      "ColorScreenServe",
      "ColorScreenCaosNominated"
    ]
  },
  "ColorSettingResponse": {
    "type": "object",
    "required": ["id", "target_type", "target_id", "screen", "color"],
    "properties": {
      "id": {
        "type": "string",
        "format": "uuid"
      },
      "target_type": {
        "$ref": "#/components/schemas/ColorTargetType"
      },
      "target_id": {
        "type": "string",
        "format": "uuid",
        "description": "Item または ItemType の ID"
      },
      "screen": {
        "$ref": "#/components/schemas/ColorScreen"
      },
      "color": {
        "type": "string",
        "pattern": "^#[0-9a-fA-F]{6}$",
        "example": "#bfdbfe"
      }
    }
  },
  "ColorSettingUpsertRequest": {
    "type": "object",
    "required": ["target_type", "target_id", "screen", "color"],
    "properties": {
      "target_type": {
        "$ref": "#/components/schemas/ColorTargetType"
      },
      "target_id": {
        "type": "string",
        "format": "uuid",
        "description": "Item または ItemType の ID"
      },
      "screen": {
        "$ref": "#/components/schemas/ColorScreen"
      },
      "color": {
        "type": "string",
        "pattern": "^#[0-9a-fA-F]{6}$",
        "example": "#bfdbfe"
      }
    }
  },
  "PrinterSettingsResponse": {
