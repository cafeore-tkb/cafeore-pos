{
  "name": "@cafeore/common",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "default": "./src/index.ts"
    }
  },
  "scripts": {
    "typecheck": "tsc",
    "build": "tsc -d -p tsconfig.json",
    "dl-store": "tsx src/scripts/download-orders.ts",
    "dl-state": "tsx src/scripts/download-master-state.ts",
    "rehearsal-params": "tsx src/scripts/rehearsal-params.ts",
    "generate:schemas": "tsx src/scripts/generate-openapi-schemas.ts",
    "test:unit": "vitest test -t unit"
  },
  "dependencies": {
    "ajv": "^8.18.0",
    "ajv-formats": "^3.0.1",
    "swr": "^2.3.2",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^24.5.2",
    "dayjs": "^1.11.13",
    "tsx": "^4.19.2",
    "vite": "^6.4.1",
    "vitest": "^3.0.5",
    "yaml": "^2.8.2"
  }
}
