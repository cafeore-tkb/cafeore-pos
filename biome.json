{
  "$schema": "https://biomejs.dev/schemas/1.9.4/schema.json",
  "files": {
    "ignore": [
      "**/node_modules/**",
      "**/build",
      "**/public/build",
      "**/epos-2.27.0.js"
    ]
  },
  "formatter": {
    "indentStyle": "space"
  },
  "linter": {
    "enabled": true,
    "rules": {
      "recommended": true,
      "correctness": {
        "noUnusedImports": "warn"
      },
      "nursery": {
        "useSortedClasses": "warn"
      }
    }
  },
  "overrides": [
    {
      "include": ["documents/manual/editable/caos-ipad/combine-pages.jsx"],
      "javascript": {
        "formatter": {
          "trailingCommas": "none"
        }
      },
      "linter": {
        "rules": {
          "style": {
            "useTemplate": "off",
            "noVar": "off"
          },
          "correctness": {
            "noInnerDeclarations": "off"
          }
        }
      }
    }
  ]
}
