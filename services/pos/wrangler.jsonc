{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "cafeore-pos",
  // wrangler 4.123.0 が同梱する workerd は 2026-08-11 相当。
  // ここを未来の日付にすると deploy が API 側で弾かれる。
  "compatibility_date": "2026-08-04",

  // PR ごとの versions upload で <version>-<name>.<subdomain>.workers.dev の
  // プレビュー URL を出すために有効化している。
  //
  // 注意: **閉じた PR のプレビュー URL も残り続ける。** wrangler には
  // versions delete が無く、バージョンを個別に消す手段が今のところ無い
  // （wrangler preview delete は private beta）。古いプレビューを
  // 公開したままにしたくない場合は、ここを false にして配信自体を止めること。
  "preview_urls": true,

  // 画面は静的アセット（react-router は ssr: false なので build/client の中身だけ）。
  // スクリプトは API への中継だけを受け持つ（worker/index.ts の冒頭を参照）。
  "main": "./worker/index.ts",

  // 中継先は API_ORIGIN（本番の Cloud Run の URL）。
  //
  // --var API_ORIGIN:... を渡したデプロイでは、そちらが優先される（デプロイの
  // workflow は Variables の WORKERS_API_ORIGIN があるときだけ渡す）。
  //
  // 注意: --var を渡さない wrangler versions upload（PR のプレビュー）と
  // wrangler dev にもこの値が入るので、それらの /api も本番の API へ中継される。
  "vars": {
    "API_ORIGIN": "https://cafeore-pos-prod-185193732958.asia-northeast1.run.app"
  },

  "assets": {
    "directory": "./build/client",
    "binding": "ASSETS",
    // SPA なので、アセットに無いパスは 404 ではなく index.html を返す。
    "not_found_handling": "single-page-application",
    // この3つだけはアセットより先にスクリプトへ回す。無いと上のフォールバックで
    // index.html が返り、API に届かない。**worker/index.ts の API_PATH と揃えること。**
    "run_worker_first": ["/api/*", "/status", "/health"]
  }
}
