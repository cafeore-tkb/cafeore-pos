{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "cafeore-pos",
  // wrangler 4.123.0 が同梱する workerd は 2026-08-11 相当。
  // ここを未来の日付にすると deploy が API 側で弾かれる。
  "compatibility_date": "2026-08-04",

  // main（Worker のスクリプト）を持たない、静的アセットだけの Worker。
  // react-router は ssr: false なので、出荷するのは build/client の中身だけ。
  "assets": {
    "directory": "./build/client",
    // SPA なので、アセットに無いパスは 404 ではなく index.html を返す。
    // Firebase Hosting 側の rewrites（firebase.json）と同じ挙動。
    "not_found_handling": "single-page-application"
  }
}
