{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "cafeore-pos",
  // wrangler 4.123.0 が同梱する workerd は 2026-08-11 相当。
  // ここを未来の日付にすると deploy が API 側で弾かれる。
  "compatibility_date": "2026-08-04",

  // PR ごとの versions upload で <version>-<name>.<subdomain>.workers.dev の
  // プレビュー URL を出すために有効化している。
  //
  // 注意: **閉じた PR のプレビュー URL も残り続ける。** wrangler には
  // versions delete が無く、バージョンを個別に消す手段が今のところ無い
  // （wrangler preview delete は private beta）。古いプレビューを
  // 公開したままにしたくない場合は、ここを false にして配信自体を止めること。
  "preview_urls": true,

  // Workers Logs。console.log などの出力と、リクエストごとの呼び出しログ
  // （invocation_logs）をダッシュボードで検索できるように残す（persist）。
  "observability": {
    "logs": {
      "enabled": true,
      "invocation_logs": true,
      "persist": true
    }
  },

  // 画面は静的アセット（react-router は ssr: false なので build/client の中身だけ）。
  // スクリプトは API への中継だけを受け持つ（worker/index.ts の冒頭を参照）。
  //
  // 中継先は API_ORIGIN。デプロイの workflow が --var で渡すので、ここには書かない
  // （ここに書くと、渡さなかったデプロイで古い値が残る）。
  "main": "./worker/index.ts",

  "assets": {
    "directory": "./build/client",
    "binding": "ASSETS",
    // SPA なので、アセットに無いパスは 404 ではなく index.html を返す。
    "not_found_handling": "single-page-application",
    // これらだけはアセットより先にスクリプトへ回す。無いと上のフォールバックで
    // index.html が返り、API に届かない。**worker/index.ts の API_PATH・CALL_VOICE_PREFIX と揃えること。**
    "run_worker_first": ["/api/*", "/status", "/health", "/call-voice/*"]
  },

  // 呼び出し画面の音声（ElevenLabs で作ったもの）を溜めておくところ（worker/call-voice.ts）。
  // 本番もプレビューも同じバケットを使う（鍵は送った中身のハッシュなので、同じ文面なら同じ音声）。
  // **バケットが無いとデプロイが失敗する。** 先に wrangler r2 bucket create で作っておくこと。
  // ElevenLabs の鍵は secret の ELEVENLABS_API_KEY（デプロイの workflow が入れる）。
  "r2_buckets": [
    {
      "binding": "CALL_VOICES",
      "bucket_name": "cafeore-call-voices"
    }
  ]
}
