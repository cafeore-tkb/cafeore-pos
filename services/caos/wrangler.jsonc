{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  // 公開 URL は https://cafeore-caos.<アカウントの workers.dev のサブドメイン>.workers.dev
  // （POS の cafeore-pos と同じアカウント）。API の FRONTEND_ORIGINS にこの origin が要る。
  "name": "cafeore-caos",
  // services/pos/wrangler.jsonc と同じ日付にそろえる（未来の日付だと deploy が弾かれる）。
  "compatibility_date": "2026-08-04",

  // PR ごとの versions upload で <version>-<name>.<subdomain>.workers.dev の
  // プレビュー URL を出す（POS と同じ。閉じた PR のプレビュー URL も残り続ける点も同じ）。
  "preview_urls": true,

  // main（Worker のスクリプト）を持たない、静的アセットだけの Worker。
  "assets": {
    "directory": "./build",
    // SPA なので、アセットに無いパスは 404 ではなく index.html を返す。
    "not_found_handling": "single-page-application"
  }
}
