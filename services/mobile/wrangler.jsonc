{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "cafeore-mobile",
  // wrangler 4.123.0 が同梱する workerd は 2026-08-11 相当。
  // ここを未来の日付にすると deploy が API 側で弾かれる。
  "compatibility_date": "2026-08-04",

  // mobile は停止中なので、workers.dev の本番 URL もプレビュー URL も配信しない。
  // Worker 自体は残してあるので、手動でデプロイしてもここが false のうちは
  // 公開されない。再開するときは両方 true に戻す。
  //
  // 注意: preview_urls を true にすると **閉じた PR のプレビュー URL も
  // 残り続ける。** wrangler には versions delete が無く、バージョンを個別に
  // 消す手段が今のところ無い（wrangler preview delete は private beta）。
  "workers_dev": false,
  "preview_urls": false,

  // main（Worker のスクリプト）を持たない、静的アセットだけの Worker。
  // react-router は ssr: false なので、出荷するのは build/client の中身だけ。
  //
  // Cloudflare Pages 時代の functions/[[path]].ts は build/server を import して
  // いたが、ssr: false ではその出力自体が消えるので機能しておらず、削除した。
  "assets": {
    "directory": "./build/client",
    // SPA なので、アセットに無いパスは 404 ではなく index.html を返す。
    "not_found_handling": "single-page-application"
  }
}
